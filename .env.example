APP_NAME="Racunin"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Database (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=affiliate_system
DB_USERNAME=postgres
DB_PASSWORD=

# Session & Cache
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Queue & Cache Store
# Redis keeps the redirect hot path off the database (cache lookups, click-tracking jobs).
# "database" also works for small/local setups.
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Google Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# Allowed short-link destination domains (comma separated, subdomains included)
# Extra store domains beyond the built-in marketplaces (comma separated)
AFFILIATE_EXTRA_DOMAINS=
# Android in-app browsers (Instagram, TikTok, Facebook): try opening the store app first
AFFILIATE_OPEN_IN_APP=false

# Google OAuth (Socialite)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Mail (Optional)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="support@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Storage
FILESYSTEM_DISK=public

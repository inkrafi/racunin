# ==============================================================================
# SHOPEE AFFILIATE SYSTEM — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

APP_NAME="Shopee Affiliate System"
APP_ENV=production
APP_KEY= # Generate with: php artisan key:generate
APP_DEBUG=false
APP_URL=https://affiliate.yourdomain.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# Database Configuration (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=affiliate_system_prod
DB_USERNAME=affiliate_user
DB_PASSWORD=your_strong_production_password

# Session & Security
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# Cache & Queues (Redis Recommended for High Traffic)
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mail Settings (Optional)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Google Gemini AI API Configuration
GEMINI_API_KEY=AIzaSy_YOUR_PRODUCTION_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=20

# Vite
# VITE_APP_NAME="${APP_NAME}"

# ==========================================
# 6. OAUTH GOOGLE LOGIN
# ==========================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
